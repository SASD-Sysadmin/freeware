# Normalize text and keep Unix scripts independent of contributors' platforms.
* text=auto
*.sh text eol=lf
*.bash text eol=lf
*.tcsh text eol=lf
*.csh text eol=lf
*.pl text eol=lf
*.pm text eol=lf
*.py text eol=lf
*.md text eol=lf
*.1 text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Makefile text eol=lf
bin/* text eol=lf
sbin/* text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
