#!/usr/bin/env perl
# SPDX-License-Identifier: MIT
# M7.3: Bounded, offline OpenSSH server authentication log-pattern summary.
#
# Scope is intentionally narrower than "authentication monitoring": we count
# *message patterns* in RFC3164-like, local, line-oriented syslog exports.
# They are not authenticated evidence of users, IPs, unique attempts, attacks
# or successful sessions. No system login, journalctl call, or other side effect
# is ever performed. Linux and macOS may have different native log formats.
use strict;
use warnings;
use Getopt::Long qw(GetOptions);

my $VERSION = '0.1.0';
my $MAX_BYTES = 16 * 1024 * 1024;
my $MAX_LINE = 128 * 1024;
my $MAX_RECORDS = 50_000;
my @kinds = qw(ACCEPTED FAILED INVALID_USER OTHER_SSHD OTHER_SERVICE UNKNOWN);
my ($help, $version, $input, $null) = (0, 0, '-', 0);
Getopt::Long::Configure('no_auto_abbrev', 'no_ignore_case');
GetOptions('help|h' => \$help, 'version' => \$version,
           'input=s' => \$input, 'null' => \$null) or usage(2);
usage(0) if $help;
if ($version) { print "ssh-auth-summary $VERSION\n"; exit 0; }
usage(2) if @ARGV || !defined($input) || !length($input);

my $fh;
if ($input eq '-') {
    $fh = *STDIN;
} else {
    # Checking the filesystem entry first rejects symlinks. Checking fstat
    # again after open protects against a replaced file during the open race.
    # Do not print the path, even on an error: it may identify a private host.
    my @before = lstat($input);
    @before && -f _ && !-l _ && -r _
        or fail(3, 'input must be a readable regular file, not a symlink');
    open $fh, '<', $input or fail(3, 'cannot open input');
    my @after = stat($fh);
    @after && -f $fh && $before[0] == $after[0] && $before[1] == $after[1]
        or fail(3, 'input changed during open or is not a regular file');
}
binmode($fh);

# A finite snapshot is buffered only within hard limits. We validate the whole
# snapshot BEFORE producing any stdout, since truncated reports could mislead
# scripts that ingest security-related counts. This is not a follow service.
my $data = '';
while (1) {
    my $got = read($fh, my $chunk, 8192);
    defined($got) or fail(3, 'cannot read input');
    last if !$got;
    length($data) + $got <= $MAX_BYTES
        or fail(3, 'input exceeds byte limit');
    $data .= $chunk;
}
close($fh) or fail(3, 'cannot close input') if $input ne '-';
length($data) == 0 || $data =~ /\n\z/
    or fail(3, 'unterminated final record');
my @records = length($data) ? split(/\n/, $data, -1) : ();
pop @records if @records; # split's terminal field corresponds to final LF
@records <= $MAX_RECORDS or fail(3, 'record count exceeds limit');

my %counts = map { $_ => 0 } @kinds;
for my $line (@records) {
    # Physical-line limits are checked before CRLF normalization. NUL and
    # bare CR indicate unsafe/broken framing: these are fatal, not UNKNOWN.
    length($line) && length($line) <= $MAX_LINE
        or fail(3, 'empty or oversized record');
    $line =~ s/\r\z//;
    length($line) && $line !~ /[\x00\r]/
        or fail(3, 'invalid record framing');
    my $kind = classify($line);
    ++$counts{$kind};
}

# The entire report is fixed vocabulary plus bounded integer counters.
# Never echo MESSAGE, host, user, remote address, PID, timestamp or filepath;
# this also prevents untrusted terminal escape sequences reaching a console.
if ($null) {
    print "$_\0$counts{$_}\0" for @kinds;
    print "TOTAL\0", scalar(@records), "\0";
} else {
    print "EVENT\tCOUNT\n";
    print "$_\t$counts{$_}\n" for @kinds;
    print "TOTAL\t", scalar(@records), "\n";
}
# UNKNOWN means the input was fully read but at least one envelope could not
# be interpreted. FAILED/INVALID_USER are logged patterns, not tool failures.
exit($counts{UNKNOWN} ? 1 : 0);

sub classify {
    my ($line) = @_;
    # PRI (when present) is syntactic metadata, not an authentication outcome.
    # Never mine <3> fragments embedded later in a message for severity or
    # interpret malformed leading PRI as ordinary message content.
    if ($line =~ /\A</) {
        $line =~ s/\A<((?:0|[1-9][0-9]{0,2}))>//
            or return 'UNKNOWN';
        $1 <= 191 or return 'UNKNOWN';
    }

    # RFC3164-like local files frequently omit PRI. Require a calendar/time
    # envelope and a precisely separated application tag; timestamps alone
    # or keywords in arbitrary text are insufficient to classify an event.
    $line =~ /\A(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[ ]+
                ([0-9]{1,2})[ ]+([0-9]{2}):([0-9]{2}):([0-9]{2})[ ]+
                ([A-Za-z0-9][A-Za-z0-9_.:-]{0,254})[ ]+
                ([A-Za-z0-9_.\/-]{1,128})(?:\[([0-9]{1,10})\])?:[ ]+(.+)\z/sx
        or return 'UNKNOWN';
    my ($month, $day, $hour, $minute, $second, $app, $message) =
        ($1, $2, $3, $4, $5, $7, $9);
    my %month_days = (Jan=>31, Feb=>29, Mar=>31, Apr=>30, May=>31,
                      Jun=>30, Jul=>31, Aug=>31, Sep=>30, Oct=>31,
                      Nov=>30, Dec=>31);
    $day >= 1 && $day <= $month_days{$month} && $hour <= 23 &&
        $minute <= 59 && $second <= 59
        or return 'UNKNOWN';
    return 'OTHER_SERVICE' unless $app eq 'sshd';

    # The specific "Accepted", "Failed", "Invalid user" phrases are
    # anchored to the start of sshd's message. The remaining fields must
    # look like a source address, port and SSH protocol suffix. A word such
    # as "Accepted" inside an unrelated line is not sufficient evidence.
    # Neither addresses nor user fields are validated as genuine identities.
    my $user = qr/[^\x00-\x20\x7f]{1,255}/;
    my $addr = qr/[0-9A-Fa-f:.]{1,64}/;
    my $port = qr/([0-9]{1,5})/;
    my $method = qr/(?:password|publickey|keyboard-interactive\/pam|gssapi-with-mic)/;
    if ($message =~ /\AAccepted $method for $user from $addr port $port ssh2(?::|[ ]|\z)/) {
        return 'ACCEPTED' if $1 >= 1 && $1 <= 65535;
    }
    if ($message =~ /\AFailed $method for (?:invalid user )?$user from $addr port $port ssh2(?::|[ ]|\z)/) {
        return 'FAILED' if $1 >= 1 && $1 <= 65535;
    }
    if ($message =~ /\AInvalid user $user from $addr port $port(?:[ ]|\z)/) {
        return 'INVALID_USER' if $1 >= 1 && $1 <= 65535;
    }
    return 'OTHER_SSHD';
}

sub fail {
    my ($status, $reason) = @_;
    warn "ssh-auth-summary: $reason\n";
    exit $status;
}
sub usage {
    my ($status) = @_;
    my $stream = $status ? *STDERR : *STDOUT;
    print {$stream} <<'USAGE';
Usage: ssh-auth-summary [--input FILE|-] [--null] [--help | --version]
Read finite RFC3164-like local syslog text with optional leading PRI.
Count OpenSSH sshd message patterns, not unique logins or verified attacks.
Reports only category counts; never shows messages, usernames or IPs.
Input: stdin by default; named files must be regular and not symlinks.
--null: seven records of two NUL-terminated fields, without TSV header.
Exit: 0 complete; 1 unknown envelope(s); 2 invalid CLI;
      3 unreadable, incomplete, malformed or oversized input.
USAGE
    exit $status;
}
