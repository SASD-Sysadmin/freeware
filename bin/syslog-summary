#!/usr/bin/env perl
# SPDX-License-Identifier: MIT
# M7.2: Read-only, privacy-preserving severity accounting for bounded syslog.
#
# Why a separate tool? The earlier log-summary searches arbitrary message text
# for words like "error". Such words are not trustworthy syslog priorities.
# A severity is counted here ONLY if a numeric PRI precedes a structurally
# valid RFC3164 or RFC5424 envelope. Invalid/absent PRI becomes UNKNOWN.
#
# This program deliberately reads offline files or stdin; it never launches
# journalctl, reads privileged paths by default or alters any log source.
use strict;
use warnings;
use Getopt::Long qw(GetOptions);

my $VERSION = '0.1.0';
my $MAX_BYTES = 16 * 1024 * 1024;
my $MAX_LINE = 128 * 1024;
my $MAX_RECORDS = 50_000;
my @levels = qw(EMERGENCY ALERT CRITICAL ERROR WARNING NOTICE INFO DEBUG);
my ($help, $version, $input, $format, $null) = (0, 0, '-', 'auto', 0);
Getopt::Long::Configure('no_auto_abbrev', 'no_ignore_case');
GetOptions('help|h' => \$help, 'version' => \$version,
           'input=s' => \$input, 'format=s' => \$format,
           'null' => \$null) or usage(2);
usage(0) if $help;
if ($version) { print "syslog-summary $VERSION\n"; exit 0; }
usage(2) if @ARGV || !defined($input) || !length($input) ||
    !defined($format) || $format !~ /\A(?:auto|rfc3164|rfc5424)\z/;

my $fh;
if ($input eq '-') {
    $fh = *STDIN;
} else {
    # Reject links and non-files before opening, then recheck the descriptor.
    # The second check catches a normal path->symlink replacement race. Never
    # print the path in errors; log source names can reveal private details.
    my @before = lstat($input);
    @before && -f _ && !-l _ && -r _
        or fail(3, 'input must be a readable regular file, not a symlink');
    open $fh, '<', $input or fail(3, 'cannot open input file');
    my @after = stat($fh);
    @after && -f $fh && $before[0] == $after[0] &&
        $before[1] == $after[1]
        or fail(3, 'input changed during open or is not a regular file');
}
binmode($fh);

# Read first, validate completely, and only then print. A halfway report on
# a broken source could mislead monitoring, so there are NO partial counts.
# Like M7.1 this intentionally accepts finite snapshots, not tail -f streams.
my $data = '';
while (1) {
    my $got = read($fh, my $chunk, 8192);
    defined($got) or fail(3, 'cannot read input');
    last if $got == 0;
    length($data) + $got <= $MAX_BYTES
        or fail(3, 'syslog input exceeds byte limit');
    $data .= $chunk;
}
if ($input ne '-') { close($fh) or fail(3, 'cannot close input file'); }
length($data) == 0 || $data =~ /\n\z/
    or fail(3, 'unterminated syslog line');
my @records = length($data) ? split(/\n/, $data, -1) : ();
pop @records if @records; # terminal empty field from the final LF
@records <= $MAX_RECORDS or fail(3, 'syslog record count exceeds limit');

my @counts = (0) x 8;
my $unknown = 0;
for my $line (@records) {
    length($line) && length($line) <= $MAX_LINE
        or fail(3, 'empty or oversized syslog record');
    $line =~ s/\r\z//; # allow CRLF exports, but bound the physical line above
    length($line) or fail(3, 'empty syslog record');
    my $severity = severity_from_record($line, $format);
    if (defined $severity) { ++$counts[$severity]; }
    else { ++$unknown; }
}

# Output never includes MESSAGE, hostname, tag, SD params, timestamp or path.
# The same stable three-field schema as journal-summary enables safe scripts.
my @rows;
for my $n (0 .. 7) { push @rows, [$n, $levels[$n], $counts[$n]]; }
push @rows, ['-', 'UNKNOWN', $unknown];
push @rows, ['-', 'TOTAL', scalar(@records)];
if ($null) { print join("\0", @$_), "\0" for @rows; }
else {
    print "PRIORITY\tLEVEL\tCOUNT\n";
    print join("\t", @$_), "\n" for @rows;
}
exit($unknown ? 1 : 0);

sub severity_from_record {
    my ($line, $chosen) = @_;
    # RFC3164/5424 PRI is an angle-bracketed decimal prefix. A candidate
    # elsewhere, including inside MESSAGE, must never determine severity.
    # Reject non-canonical leading zeros and out-of-range facilities (PRI>191).
    $line =~ /\A<([0-9]{1,3})>(.*)\z/s or return undef;
    my ($pri_text, $remainder) = ($1, $2);
    $pri_text =~ /\A(?:0|[1-9][0-9]{0,2})\z/ && $pri_text <= 191
        or return undef;
    my $valid = 0;
    $valid ||= valid_rfc3164($remainder) if $chosen ne 'rfc5424';
    $valid ||= valid_rfc5424($remainder) if $chosen ne 'rfc3164';
    return $valid ? ($pri_text % 8) : undef;
}

sub valid_rfc3164 {
    my ($line) = @_;
    # RFC3164's traditional timestamp deliberately has no year/timezone.
    # Both 'Oct  9' and 'Oct 21' are normal. Mere '<N>' followed by
    # arbitrary words is NOT a valid syslog event.
    $line =~ /\A(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[ ]+
                ([0-9]{1,2})[ ]+([0-9]{2}):([0-9]{2}):([0-9]{2})[ ]+
                ([A-Za-z0-9][A-Za-z0-9_.:-]{0,254})[ ]+(\S.*)\z/sx
        or return 0;
    my ($month, $day, $hour, $minute, $second) = ($1, $2, $3, $4, $5);
    # RFC3164 carries no year, so February 29 is plausible in a leap year.
    # Other impossible calendar dates must not authenticate a forged prefix.
    my %month_days = (Jan => 31, Feb => 29, Mar => 31, Apr => 30,
                      May => 31, Jun => 30, Jul => 31, Aug => 31,
                      Sep => 30, Oct => 31, Nov => 30, Dec => 31);
    return $day >= 1 && $day <= $month_days{$month} && $hour <= 23 &&
        $minute <= 59 && $second <= 59;
}

sub valid_rfc5424 {
    my ($line) = @_;
    # Only VERSION=1 is supported. Require all six RFC5424 header tokens
    # (including structured data) instead of accepting an ISO timestamp
    # or an incidental '<PRI>1' at the beginning of arbitrary text.
    $line =~ /\A1[ ]([^ ]{1,64})[ ]([^ ]{1,255})[ ]([^ ]{1,48})
                 [ ]([^ ]{1,128})[ ]([^ ]{1,32})[ ](.*)\z/sx
        or return 0;
    my ($stamp, $host, $app, $proc, $msgid, $sd) =
        ($1, $2, $3, $4, $5, $6);
    for my $name ($host, $app, $proc, $msgid) {
        $name =~ /\A[\x21-\x7e]+\z/ or return 0;
    }
    valid_timestamp($stamp) or return 0;
    return valid_structured_data($sd);
}

sub valid_timestamp {
    my ($stamp) = @_;
    return 1 if $stamp eq '-'; # RFC5424 NILVALUE (unavailable timestamp)
    $stamp =~ /\A([0-9]{4})-([0-9]{2})-([0-9]{2})T
                 ([0-9]{2}):([0-9]{2}):([0-9]{2})
                 (?:\.[0-9]{1,6})?(?:Z|([+-])([0-9]{2}):([0-9]{2}))\z/x
        or return 0;
    my ($year, $month, $day, $h, $m, $s, $sign, $tz_h, $tz_m) =
        ($1, $2, $3, $4, $5, $6, $7, $8, $9);
    return 0 if $year < 1 || $month < 1 || $month > 12 ||
                $h > 23 || $m > 59 || $s > 60;
    my @days = (0, 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31);
    $days[2] = 29 if $year % 4 == 0 && ($year % 100 != 0 || $year % 400 == 0);
    return 0 if $day < 1 || $day > $days[$month];
    return 0 if defined($sign) && ($tz_h > 23 || $tz_m > 59);
    return 1;
}

sub valid_structured_data {
    my ($s) = @_;
    # With NILVALUE, a separating space may precede an opaque MESSAGE.
    return 1 if $s eq '-' || $s =~ /\A- /s;
    # RFC5424 allows adjacent [SD-ID ...] elements. Recognize delimiters,
    # parameter names and quoted/escaped values without ever decoding or
    # printing their contents. A dangling quote/escape invalidates the header.
    return 0 unless substr($s, 0, 1) eq '[';
    my $pos = 0;
    my $size = length($s);
    while ($pos < $size && substr($s, $pos, 1) eq '[') {
        ++$pos;
        my $id = read_sd_name($s, \$pos);
        return 0 unless defined $id;
        while ($pos < $size && substr($s, $pos, 1) eq ' ') {
            ++$pos;
            my $param = read_sd_name($s, \$pos);
            return 0 unless defined $param;
            return 0 unless substr($s, $pos, 2) eq '="';
            $pos += 2;
            my $closed = 0;
            while ($pos < $size) {
                my $c = substr($s, $pos++, 1);
                if ($c eq '"') { $closed = 1; last; }
                if ($c eq '\\') {
                    return 0 if $pos >= $size;
                    my $escaped = substr($s, $pos, 1);
                    # RFC5424 only assigns escape semantics to ", \\, and ].
                    # For \q, the backslash is ordinary data and the next
                    # character must be parsed normally (not silently lost).
                    ++$pos if $escaped eq '"' || $escaped eq '\\' || $escaped eq ']';
                } elsif ($c eq ']' || ord($c) < 32 || ord($c) == 127) {
                    return 0;
                }
            }
            return 0 unless $closed;
        }
        return 0 unless $pos < $size && substr($s, $pos++, 1) eq ']';
    }
    # After the last SD element the record may end, or a SP separates MSG.
    return $pos == $size || substr($s, $pos, 1) eq ' ';
}

sub read_sd_name {
    my ($s, $at) = @_;
    my $start = $$at;
    my $length = length($s);
    while ($$at < $length) {
        my $c = substr($s, $$at, 1);
        last if $c eq ' ' || $c eq '=' || $c eq ']' || $c eq '"';
        my $ord = ord($c);
        return undef if $ord < 33 || $ord > 126 || $c eq '[';
        ++$$at;
        return undef if $$at - $start > 32;
    }
    return undef if $$at == $start;
    return substr($s, $start, $$at - $start);
}

sub fail {
    my ($status, $message) = @_;
    warn "syslog-summary: $message\n";
    exit $status;
}
sub usage {
    my ($status) = @_;
    my $out = $status ? *STDERR : *STDOUT;
    print {$out} <<'HELP';
Usage: syslog-summary [--input FILE|-] [--format auto|rfc3164|rfc5424] [--null]
       syslog-summary --help | --version
Bounded, offline RFC3164/RFC5424 priority summary. No log content disclosed.
A severity is known only with a valid leading <PRI> and valid syslog header.
Missing or invalid metadata is counted UNKNOWN, never guessed from MESSAGE.
--input defaults to stdin; --format defaults to auto. No file modifications.
--null emits three NUL-terminated fields per row (no heading).
Exit: 0 all priorities recognized; 1 unknown; 2 invalid CLI;
      3 unreadable, incomplete or oversized input.
HELP
    exit $status;
}
