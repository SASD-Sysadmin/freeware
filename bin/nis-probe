#!/usr/bin/env perl
# SPDX-License-Identifier: MIT
# Read-only NIS binding check. Never fetches passwd/group maps.
use strict;
use warnings;
use Getopt::Long qw(GetOptions);
use FindBin;
use lib "$FindBin::Bin/../lib";
BEGIN {unless (eval{require SASD::Freeware::External;1}) {
    print STDERR "nis-probe: bundled Perl library unavailable: $@";exit 3;
}}
use SASD::Freeware::External qw(find_program);
my $VERSION='0.1.0';
my ($help,$version,$domain,$timeout)=(0,0,undef,3);
Getopt::Long::Configure('no_auto_abbrev','no_ignore_case');
GetOptions('help|h'=>\$help,'version'=>\$version,
           'domain=s'=>\$domain,'timeout=s'=>\$timeout) or usage(2);
usage(0) if $help;
if ($version) {print "nis-probe $VERSION\n";exit 0;}
usage(2) if @ARGV || $timeout !~ /\A(?:[1-9]|10)\z/;
if (defined $domain) {
    length($domain)>=1 && length($domain)<=253 &&
    $domain =~ /\A[a-zA-Z0-9_](?:[a-zA-Z0-9_.-]*[a-zA-Z0-9_])?\z/
        or fail('domain must be a simple NIS domain name without options or control bytes',2);
}
my $ypwhich=find_program('ypwhich');
defined($ypwhich) or fail('ypwhich not found; NIS clients may not be installed or supported',3);
my @args=defined($domain) ? ('-d',$domain) : ();
my $pid=open(my $fh,'-|',$ypwhich,@args);
defined($pid) or fail("cannot start ypwhich: $!",3);
my $output='';
my $done=eval {
    local $SIG{ALRM}=sub {die "NIS binding check exceeded timeout\n"};
    alarm($timeout+5);
    while (1) {
        my $bytes=read($fh,my $chunk,4096);
        defined($bytes) or die "cannot read ypwhich output: $!\n";
        last if !$bytes;
        length($output)+$bytes<=8192 or die "ypwhich output too large\n";
        $output.=$chunk;
    }
    alarm(0);1;
};
if (!$done) {my $why=$@;alarm(0);kill 'KILL',$pid if $pid>0;close $fh;
    $why =~ s/\s+\z//;fail("$why; result discarded",3);}
my $ok=close $fh;
$ok or fail('ypwhich failed: NIS domain unbound or server unavailable (consult local NIS configuration)',1);
$output =~ s/\s+\z//;
length($output)>0 or fail('ypwhich succeeded but reported no bound NIS server',1);
$output =~ s/([\\\x00-\x1f\x7f])/sprintf('\\x%02X',ord($1))/ge;
print "NIS binding: $output\n";
print "Scope: local ypwhich result only; no NIS maps queried\n";
exit 0;
sub fail {my($s,$rc)=@_;warn "nis-probe: $s\n";exit $rc;}
sub usage {my($rc)=@_;my$o=$rc?*STDERR:*STDOUT;print {$o} <<'USAGE';
Usage: nis-probe [--domain DOMAIN] [--timeout 1..10]
       nis-probe --help | --version
Read-only NIS/YP binding check via an optional ypwhich command.
Does not enumerate NIS maps or request passwd/group information.
Exit 0 = bound server reported, 1 = not bound or unavailable, 2 = usage, 3 = missing client/error.
USAGE
exit $rc;}
