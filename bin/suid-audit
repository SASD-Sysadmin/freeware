#!/usr/bin/env perl
# SPDX-License-Identifier: MIT
# Read-only permission inventory. A setuid bit is not automatically a vulnerability.
use strict;
use warnings;
use Getopt::Long qw(GetOptions);
use File::Find;

my ($root, $help) = (undef, 0);
GetOptions('root=s' => \$root, 'help' => \$help) or usage(2);
usage(0) if $help;
usage(2) if @ARGV || !defined $root;
-d $root && !-l $root or die "suid-audit: expected a real directory: $root\n";
my ($scanned, $found, $errors) = (0,0,0);
find({ no_chdir => 1, follow => 0, wanted => sub {
    my $path = $File::Find::name;
    return if -l $path || !-f $path;
    $scanned++;
    my @st = lstat($path);
    if (!@st) {
        warn "suid-audit: cannot stat $path: $!\n";
        $errors++;
        return;
    }
    my @flags;
    push @flags, 'SUID' if $st[2] & 04000;
    push @flags, 'SGID' if $st[2] & 02000;
    if (@flags) {
        $found++;
        printf "%s mode=%04o uid=%d gid=%d %s\n",
            join('+', @flags), $st[2] & 07777, $st[4], $st[5], $path;
    }
}}, $root);
print "SUMMARY: scanned=$scanned privileged=$found errors=$errors\n";
exit($errors ? 2 : 0);

sub usage {
    my ($code) = @_;
    print {$code ? *STDERR : *STDOUT} "Usage: suid-audit --root DIRECTORY [--help]\n";
    exit $code;
}
