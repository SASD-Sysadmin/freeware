#!/usr/bin/env perl
# SPDX-License-Identifier: MIT
# Read-only symbolic-link inventory using the operating system's file metadata.
use strict;
use warnings;
use Getopt::Long qw(GetOptions);
use FindBin;
use lib "$FindBin::Bin/../lib";
use Errno qw(ENOENT ENOTDIR ELOOP);
BEGIN {
    unless (eval { require SASD::Freeware::Walk; 1 }) {
        print STDERR "link-audit: required Perl module SASD::Freeware::Walk is unavailable; reinstall SASD Freeware with its lib/ directory: $@";
        exit 3;
    }
}
use SASD::Freeware::Walk qw(walk_tree directory_root display_path);
use Fcntl qw(S_ISLNK);

my $VERSION = '0.1.0';
my ($help, $version, $one_fs, $all, $null) = (0, 0, 0, 0, 0);
Getopt::Long::Configure('no_auto_abbrev', 'no_ignore_case');
GetOptions('help|h' => \$help, 'version' => \$version,
           'one-file-system' => \$one_fs, 'all' => \$all, 'null' => \$null)
    or usage(2);
usage(0) if $help;
if ($version) { print "link-audit $VERSION\n"; exit 0; }
usage(2) unless @ARGV == 1;
my $root = shift @ARGV;
$root =~ s{/+\z}{} unless $root =~ m{\A/+\z};
my $problem = directory_root($root);
if ($problem ne '') { warn "link-audit: $problem\n"; exit 1; }

my ($scanned, $findings, $unresolved) = (0, 0, 0);
print "STATUS\tPATH\tTARGET\n" unless $null;
my $errors = walk_tree($root, $one_fs,
    sub {
        my ($path, $st) = @_;
        return unless S_ISLNK($st->[2]);
        ++$scanned;
        my $target = readlink($path);
        my $status;
        if (!defined($target)) {
            $target = '';
            $status = 'unresolved';
        } elsif (stat($path)) {
            $status = 'valid';
        } elsif ($! == ENOENT || $! == ENOTDIR) {
            $status = 'dangling';
        } elsif ($! == ELOOP) {
            $status = 'loop';
        } else {
            $status = 'unresolved';
        }
        ++$unresolved if $status eq 'unresolved';
        return if $status eq 'valid' && !$all;
        ++$findings;
        if ($null) {
            print join("\0", $status, $path, $target), "\0";
        } else {
            print join("\t", $status, display_path($path), display_path($target)), "\n";
        }
    },
    sub {
        my ($path, $message) = @_;
        warn "link-audit: ", display_path($path), ": $message\n";
    });
print "Symlinks scanned: $scanned\nFindings: $findings\nErrors: ",
      ($errors + $unresolved), "\n" unless $null;
exit($errors || $unresolved ? 1 : 0);

sub usage {
    my ($code) = @_;
    my $out = $code ? *STDERR : *STDOUT;
    print {$out} <<'HELP';
Usage: link-audit [--all] [--one-file-system] [--null] DIRECTORY
       link-audit --help | --version
Report dangling, looping or unresolved symbolic links. Never follow directory links.
--all              Include valid symbolic links in the report.
--one-file-system  Do not descend into other filesystems.
--null             Output NUL-separated STATUS, PATH, TARGET records.
HELP
    exit $code;
}
