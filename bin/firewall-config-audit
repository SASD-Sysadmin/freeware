#!/usr/bin/env perl
# SPDX-License-Identifier: MIT
# M8.4 – Conservative, read-only Linux/BSD/Solaris firewall snapshot audit.
#
# Architecture boundaries:
#   * CLI: explicit source selection, safe descriptor ownership, 8 MiB limit.
#   * Native acquisition: trusted absolute path and fixed, read-only args.
#   * Pure parser: source-specific interpretation and bounded output rows.
#   * Presentation: no addresses, comments or untrusted rules are disclosed.
#
# We do not infer host-wide firewall safety from UFW status, nftables chains,
# or iptables-save output. Different tools can describe overlapping backends.
# A missing command, denied access, or parse failure is UNKNOWN, not INACTIVE.
use strict;
use warnings;
use Getopt::Long qw(GetOptions);
use FindBin;
use lib "$FindBin::Bin/../lib";
use SASD::Freeware::FirewallAudit qw(parse_snapshot);

my $VERSION = '0.1.0';
my $MAX_BYTES = 8 * 1024 * 1024;
my ($help, $version, $source, $input, $null) = (0, 0, undef, undef, 0);
Getopt::Long::Configure('no_auto_abbrev', 'no_ignore_case');
GetOptions('help|h' => \$help, 'version' => \$version,
           'source=s' => \$source, 'input=s' => \$input, 'null' => \$null)
    or usage(2);
usage(0) if $help;
if ($version) { print "firewall-config-audit $VERSION\n"; exit 0; }
usage(2) if @ARGV || !defined($source) ||
    $source !~ /\A(?:ufw-config|ufw-status|nft-json|iptables-save|ip6tables-save|pf-info|pf-rules|ipfw-list|npf-show|solaris-pf-service|solaris-pf-rules|solaris-ipf-service|solaris-ipf-rules4|solaris-ipf-rules6)\z/ ||
    (defined($input) && !length($input));

# A fixture file and an actual kernel snapshot use the identical parser.
# This makes portability testing independent from root privileges, test
# machines and live firewall services. The operator must name the source;
# guessing a firewall dialect from arbitrary text would be misleading.
my ($fh, $backend);
if (defined($input)) {
    if ($input eq '-') {
        $fh = *STDIN;
    } else {
        $fh = open_regular($input);
    }
} else {
    # Native capabilities depend on the actual OS, not the presence of a
    # similarly named executable. macOS PF, for example, has differences from
    # the OpenBSD/FreeBSD output contract and remains offline-only here.
    if ($source =~ /\Asolaris-(?:pf|ipf)-/) {
        # Solaris 10/11 IPFilter and 11.3+ PF share no reliable enablement
        # flag. SMF service state is deliberately captured separately.
        $^O =~ /\A(?:solaris|sunos)\z/ or fail(3, 'native Solaris firewall backend is unsupported on this OS; use --input');
    } elsif ($source =~ /\A(?:pf-info|pf-rules|ipfw-list|npf-show)\z/) {
        my %platforms = (
            'pf-info'  => { openbsd => 1, freebsd => 1 },
            'pf-rules' => { openbsd => 1, freebsd => 1 },
            'ipfw-list' => { freebsd => 1 },
            'npf-show'  => { netbsd => 1 },
        );
        $platforms{$source}{$^O}
            or fail(3, 'native BSD firewall backend is unsupported on this OS; use --input');
    } else {
        $^O eq 'linux' or fail(3, 'native Linux firewall backend is unsupported on this OS; use --input');
    }
    if ($source eq 'ufw-config') {
        $fh = open_regular('/etc/ufw/ufw.conf');
    } else {
        my (@candidates, @args);
        if ($source eq 'solaris-pf-service' || $source eq 'solaris-ipf-service') {
            # The Solaris Service Management Facility is READ ONLY here.
            # We do not issue svcadm or change the service repository.
            @candidates = qw(/usr/bin/svcs /usr/sbin/svcs /bin/svcs);
            my $fmri = $source eq 'solaris-pf-service'
                ? 'svc:/network/firewall:default'
                : 'svc:/network/ipfilter:default';
            @args = ('-H', '-o', 'state', $fmri);
        } elsif ($source eq 'solaris-pf-rules') {
            @candidates = qw(/usr/sbin/pfctl /sbin/pfctl);
            @args = ('-sr');
        } elsif ($source eq 'solaris-ipf-rules4' || $source eq 'solaris-ipf-rules6') {
            @candidates = qw(/usr/sbin/ipfstat /sbin/ipfstat);
            @args = ($source eq 'solaris-ipf-rules6' ? '-6io' : '-io');
        } elsif ($source eq 'ufw-status') {
            @candidates = qw(/usr/sbin/ufw /sbin/ufw /usr/bin/ufw /bin/ufw);
            @args = ('status', 'verbose');
        } elsif ($source eq 'nft-json') {
            @candidates = qw(/usr/sbin/nft /sbin/nft /usr/bin/nft /bin/nft);
            @args = ('--json', 'list', 'ruleset');
        } elsif ($source eq 'iptables-save') {
            @candidates = qw(/usr/sbin/iptables-save /sbin/iptables-save /usr/bin/iptables-save);
        } elsif ($source eq 'ip6tables-save') {
            @candidates = qw(/usr/sbin/ip6tables-save /sbin/ip6tables-save /usr/bin/ip6tables-save);
        } elsif ($source eq 'pf-info' || $source eq 'pf-rules') {
            @candidates = qw(/sbin/pfctl /usr/sbin/pfctl);
            @args = ('-s', $source eq 'pf-info' ? 'info' : 'rules');
        } elsif ($source eq 'ipfw-list') {
            @candidates = qw(/sbin/ipfw /usr/sbin/ipfw);
            @args = ('list');
        } elsif ($source eq 'npf-show') {
            @candidates = qw(/sbin/npfctl /usr/sbin/npfctl);
            @args = ('show');
        } else {
            fail(2, 'unsupported firewall source');
        }
        # No shell, user-provided executable or arbitrary command arguments.
        # We never use an operation that changes, reloads or saves rules.
        ($backend) = grep { -f $_ && -x $_ } @candidates;
        defined($backend) or fail(3, 'selected native firewall backend is unavailable');
        {
            # Ensure status headings remain English in native captures, even
            # when the operator uses a localized terminal environment.
            local $ENV{LC_ALL} = 'C';
            open $fh, '-|', $backend, @args
                or fail(3, 'cannot launch firewall inspection backend');
        }
    }
}
binmode($fh);

# Collect ALL input in bounded memory. No output at all until both the native
# command's exit status and the parser's entire snapshot are verified.
my $text = '';
while (1) {
    my $n = read($fh, my $chunk, 8192);
    defined($n) or fail(3, 'cannot read firewall snapshot');
    last unless $n;
    length($text) + $n <= $MAX_BYTES or fail(3, 'firewall snapshot exceeds byte limit');
    $text .= $chunk;
}
# close() waits for a native child's termination and propagates failure.
# Never mistake command output before an error for a complete ruleset.
if (defined($backend)) {
    close($fh) or fail(3, 'native firewall backend failed or denied access');
} elsif (defined($input) && $input ne '-') {
    close($fh) or fail(3, 'cannot finish firewall input file');
} elsif (!defined($input) && $source eq 'ufw-config') {
    close($fh) or fail(3, 'cannot finish UFW configuration file');
}

my $rows = eval { parse_snapshot($text, $source) };
!$@ && ref($rows) eq 'ARRAY' or fail(3, 'malformed or unsupported firewall snapshot');

if ($null) {
    for my $r (@$rows) { print join("\0", @$r), "\0"; }
} else {
    print "ENGINE\tSCOPE\tSTATE\tFAMILY\tTABLE\tCHAIN\tPOLICY\tRULES\n";
    for my $r (@$rows) { print join("\t", @$r), "\n"; }
}
exit 0;

sub open_regular {
    my ($path) = @_;
    # lstat() rejects symlinks; stat(fh) after open guards against pathname
    # replacement between validation and opening the input file. Never print
    # the supplied name; paths may be private infrastructure metadata.
    my @before = lstat($path);
    @before && -f _ && !-l _ && -r _
        or fail(3, 'input must be a readable regular file, not a symlink');
    open my $local, '<', $path or fail(3, 'cannot open firewall input');
    my @after = stat($local);
    @after && -f $local && $before[0] == $after[0] && $before[1] == $after[1]
        or fail(3, 'firewall input changed while opening');
    return $local;
}
sub fail {
    my ($code, $reason) = @_;
    warn "firewall-config-audit: $reason\n";
    exit $code;
}
sub usage {
    my ($code) = @_;
    my $fh = $code ? *STDERR : *STDOUT;
    print {$fh} <<'HELP';
Usage: firewall-config-audit --source SOURCE [--input FILE|-] [--null]
       firewall-config-audit --help | --version
Linux sources: ufw-config, ufw-status, nft-json, iptables-save, ip6tables-save
BSD sources:   pf-info, pf-rules, ipfw-list, npf-show
Solaris:       solaris-pf-service, solaris-pf-rules, solaris-ipf-service,
               solaris-ipf-rules4, solaris-ipf-rules6
Native: PF on OpenBSD/FreeBSD; IPFW on FreeBSD; NPF on NetBSD;
        Solaris SMF, PF and IPFilter sources on Solaris only.
Read-only, source-tagged snapshots; --source is required and never guessed.
Without --input, run only a fixed read-only native command or read UFW config.
--input safely replays offline fixtures on Linux, macOS and other Unix systems.
TSV has eight columns; --null emits eight NUL-terminated fields per record.
PF rules and IPFW counts are PARTIAL; PF anchors and dynamic IPFW rules are
not expanded. NPF reports filtering and configuration state separately.
Solaris SMF state is not kernel state; IPFilter and Solaris PF counts are
PARTIAL. None of these sources proves whole-host firewall protection.
Exit: 0 validated source summary; 2 invalid options; 3 unavailable/denied/malformed.
HELP
    exit $code;
}
