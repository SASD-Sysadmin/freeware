#!/usr/bin/env perl
# SPDX-License-Identifier: MIT
# M8.4.1 – Fully offline, deterministic, hostile-input regression suite.
#
# We NEVER modify a host firewall, execute a real backend, or require root.
# The only invoked program is the SASD CLI with synthetic --input fixtures.
# Check both positive schemas and fail-closed behavior before GitHub CI.
use strict;
use warnings;
use Test::More;
use FindBin;
use File::Spec;
use File::Temp qw(tempdir);
use IPC::Open3;
use Symbol qw(gensym);
use JSON::PP ();

my $root = File::Spec->rel2abs("$FindBin::Bin/..");
my $tool = "$root/bin/firewall-config-audit";
my $temp = tempdir('sasd-firewall-XXXXXXXX', TMPDIR=>1, CLEANUP=>1);
my $seq=0;

sub snapshot {
    my ($text)=@_;
    my $path = "$temp/snapshot-" . (++$seq);
    open my $file, '>', $path or die "test fixture could not be created: $!";
    binmode($file);
    print {$file} $text;
    close $file or die "test fixture could not be closed: $!";
    return $path;
}
sub run_cli {
    my (@args) = @_;
    my $err = gensym;
    my $pid = open3(undef, my $out, $err, $^X, $tool, @args);
    local $/;
    my $stdout = <$out> // '';
    my $stderr = <$err> // '';
    close $out;
    close $err;
    waitpid($pid, 0);
    return ($? >> 8, $stdout, $stderr);
}
sub run_fixture {
    my ($source, $data, @extra) = @_;
    return run_cli('--source', $source, '--input', snapshot($data), @extra);
}
sub negative {
    my ($label, $source, $data) = @_;
    my ($code, $stdout, $stderr) = run_fixture($source, $data);
    is($code, 3, "$label: bad snapshot rejected");
    is($stdout, '', "$label: no partial or misleading output");
    like($stderr, qr/\Afirewall-config-audit: malformed or unsupported firewall snapshot\n\z/,
         "$label: deterministic safe error");
    unlike($stderr, qr/SECRET_TOKEN|192\.0\.2|snapshot-/,
           "$label: no path or rule contents leaked");
}

my ($code, $stdout, $stderr) = run_cli('--help');
is($code, 0, 'help exits successfully');
like($stdout, qr/\AUsage: firewall-config-audit/, 'help describes the command');
like($stdout, qr/--source is required/, 'help requires explicit dialect');
is($stderr, '', 'help emits no diagnostic');
($code, $stdout, $stderr) = run_cli('--version');
is($code, 0, 'version succeeds');
is($stdout, "firewall-config-audit 0.1.0\n", 'stable version');
is($stderr, '', 'version is quiet');

my $ufw_config = "# generated by UFW\nENABLED=yes\nLOGLEVEL=low\n";
($code, $stdout, $stderr) = run_fixture('ufw-config', $ufw_config);
is($code, 0, 'UFW configuration accepted');
is($stderr, '', 'UFW config parser quiet');
like($stdout, qr/\nufw\tconfiguration\tENABLED\t-\t-\t-\t-\t-\n\z/,
    'boot enablement not conflated with active kernel enforcement');
($code, $stdout) = run_fixture('ufw-config', "ENABLED=no\n");
is($code, 0, 'disabled UFW boot configuration is valid');
like($stdout, qr/\tDISABLED\t/, 'disabled boot configuration retained');

my $ufw_active = <<'UFW';
Status: active
Logging: on (low)
Default: deny (incoming), allow (outgoing), disabled (routed)
New profiles: skip

To                         Action      From
--                         ------      ----
22/tcp                     ALLOW IN    Anywhere
443/tcp                    DENY IN     Anywhere
UFW
($code, $stdout, $stderr) = run_fixture('ufw-status', $ufw_active);
is($code, 0, 'UFW live status snapshot accepted');
is($stderr, '', 'UFW parser quiet');
is($stdout, "ENGINE\tSCOPE\tSTATE\tFAMILY\tTABLE\tCHAIN\tPOLICY\tRULES\nufw\truntime\tACTIVE\t-\t-\t-\t-\t2\n", 'UFW reports only management status and displayed rule count');
($code, $stdout) = run_fixture('ufw-status', "Status: inactive\n");
is($code, 0, 'inactive UFW snapshot valid');
like($stdout, qr/\tINACTIVE\t.*\t0\n\z/, 'inactive frontend does not claim a kernel firewall is absent');
($code, $stdout) = run_fixture('ufw-status', "Status: active\n");
is($code, 0, 'active UFW with no displayed rules valid');
like($stdout, qr/\tACTIVE\t.*\t0\n\z/, 'empty UFW report not fabricated');

my $nft = '{"nftables":[' .
    '{"metainfo":{"version":"1.0.9"}},' .
    '{"table":{"family":"inet","name":"filter"}},' .
    '{"chain":{"family":"inet","table":"filter","name":"input","type":"filter","hook":"input","prio":0,"policy":"drop"}},' .
    '{"chain":{"family":"inet","table":"filter","name":"custom"}},' .
    '{"rule":{"family":"inet","table":"filter","chain":"input","expr":[{"match":{"left":"SECRET_TOKEN","right":"192.0.2.10"}}]}},' .
    '{"rule":{"family":"inet","table":"filter","chain":"custom","expr":[]}},' .
    '{"table":{"family":"ip","name":"nat"}},' .
    '{"set":{"family":"inet","table":"filter","name":"blocked","type":"ipv4_addr"}}]}';
($code, $stdout, $stderr) = run_fixture('nft-json', $nft);
is($code, 0, 'nft JSON accepted');
is($stderr, '', 'nft snapshot quiet');
like($stdout, qr/nftables\truntime\tOBSERVED\tinet\tfilter\tinput\tdrop\t1\n/, 'nft base chain counted');
like($stdout, qr/nftables\truntime\tOBSERVED\tinet\tfilter\tcustom\t-\t1\n/, 'nft regular chain has no default policy');
like($stdout, qr/nftables\truntime\tOBSERVED\tip\tnat\t-\t-\t0\n/, 'empty nft table retained');
unlike($stdout, qr/SECRET_TOKEN|192\.0\.2\.10/, 'nft rules and addresses not disclosed');
($code, $stdout) = run_fixture('nft-json', '{"nftables":[]}');
is($code, 0, 'empty nft JSON accepted');
like($stdout, qr/\tOBSERVED\t-\t-\t-\t-\t0\n\z/, 'empty ruleset is only observed, not called disabled');

my $ipt = <<'IPT';
# Generated by iptables-save
*filter
:INPUT DROP [0:0]
:OUTPUT ACCEPT [0:0]
:CUSTOM - [0:0]
-A INPUT -s 192.0.2.4/32 -j ACCEPT
-A INPUT -j CUSTOM
-A CUSTOM -j RETURN
COMMIT
*nat
:PREROUTING ACCEPT [0:0]
COMMIT
# Completed
IPT
($code, $stdout, $stderr) = run_fixture('iptables-save', $ipt);
is($code, 0, 'iptables-save accepted');
is($stderr, '', 'iptables parser quiet');
like($stdout, qr/iptables\truntime\tOBSERVED\tinet\tfilter\tINPUT\tDROP\t2\n/, 'iptables chain and rule count');
like($stdout, qr/iptables\truntime\tOBSERVED\tinet\tfilter\tCUSTOM\t-\t1\n/, 'user chain policy is not invented');
like($stdout, qr/iptables\truntime\tOBSERVED\tinet\tnat\tPREROUTING\tACCEPT\t0\n/, 'other table included');
unlike($stdout, qr/192\.0\.2\.4/, 'iptables rule source addresses omitted');
($code, $stdout) = run_fixture('ip6tables-save', $ipt);
is($code, 0, 'same grammar supported for IPv6 save');
like($stdout, qr/ip6tables\truntime\tOBSERVED\tinet6\tfilter\tINPUT\tDROP\t2\n/, 'IPv6 source identified');
($code, $stdout) = run_fixture('iptables-save', "# no tables currently loaded\n");
is($code, 0, 'empty iptables-save accepted');
like($stdout, qr/iptables\truntime\tOBSERVED\tinet\t-\t-\t-\t0\n/, 'empty legacy dump not called inactive');

# NUL serialization is fully regular and has no header. No arbitrary input
# appears between these fields because the parser emitted only safe tokens.
($code, $stdout) = run_fixture('ufw-status', "Status: inactive\n", '--null');
is($code, 0, 'NUL form accepted');
is(scalar(() = $stdout =~ /\0/g), 8, 'eight NUL-terminated fields');
unlike($stdout, qr/ENGINE/, 'NUL mode omits TSV header');
like($stdout, qr/\0\z/, 'last NUL field terminated');

# Simulate corruption, truncation, injection, ambiguous mappings and
# unexpected structures. Every case must fail before any output is emitted.
my @bad = (
    ['ufw-missing-status', 'ufw-status', ''],
    ['ufw-unknown-state', 'ufw-status', "Status: maybe\n"],
    ['ufw-localized-state', 'ufw-status', "Status: aktiv\n"],
    ['ufw-truncated', 'ufw-status', "Status: active"],
    ['ufw-header-not-terminated', 'ufw-status', "Status: active\nTo       Action       From\n"],
    ['ufw-rule-without-separator', 'ufw-status', "Status: active\nTo     Action     From\n"],
    ['ufw-inactive-but-extra', 'ufw-status', "Status: inactive\nALLOW ALL\n"],
    ['ufw-sensitive-raw', 'ufw-status', "Status: active\nSECRET_TOKEN\n"],
    ['ufw-bad-action', 'ufw-status', "Status: active\nTo    Action    From\n--    ------    ----\n22    HACK IN    Anywhere\n"],
    ['ufw-bare-CR', 'ufw-status', "Status: active\rHOST\n"],
    ['ufw-NUL', 'ufw-status', "Status: active\0\n"],
    ['config-empty', 'ufw-config', ''],
    ['config-no-enable', 'ufw-config', "LOGLEVEL=low\n"],
    ['config-duplicate', 'ufw-config', "ENABLED=yes\nENABLED=no\n"],
    ['config-exec-injection', 'ufw-config', "ENABLED=\$(SECRET_TOKEN)\n"],
    ['config-truncated', 'ufw-config', 'ENABLED=yes'],
    ['config-unknown-field', 'ufw-config', "ENABLED=yes\nSECRET_TOKEN=x\n"],
    ['nft-empty-doc', 'nft-json', ''],
    ['nft-invalid-json', 'nft-json', '{"nftables":'],
    ['nft-wrong-root', 'nft-json', '[]'],
    ['nft-extra-root', 'nft-json', '{"nftables":[],"extra":true}'],
    ['nft-invalid-record', 'nft-json', '{"nftables":[42]}'],
    ['nft-invalid-kind', 'nft-json', '{"nftables":[{"SECRET_TOKEN":{}}]}'],
    ['nft-duplicate-meta', 'nft-json', '{"nftables":[{"metainfo":{}},{"metainfo":{}},{"metainfo":{}}]}'],
    ['nft-duplicate-table', 'nft-json', '{"nftables":[{"table":{"family":"inet","name":"f"}},{"table":{"family":"inet","name":"f"}}]}'],
    ['nft-orphan-chain', 'nft-json', '{"nftables":[{"chain":{"family":"inet","table":"f","name":"input","hook":"input","type":"filter","policy":"drop"}}]}'],
    ['nft-orphan-rule', 'nft-json', '{"nftables":[{"rule":{"family":"inet","table":"f","chain":"missing","expr":[]}}]}'],
    ['nft-unsafe-name', 'nft-json', '{"nftables":[{"table":{"family":"inet","name":"f\\tSECRET_TOKEN"}}]}'],
    ['nft-no-base-policy', 'nft-json', '{"nftables":[{"table":{"family":"inet","name":"f"}},{"chain":{"family":"inet","table":"f","name":"input","hook":"input","type":"filter"}}]}'],
    ['nft-regular-policy', 'nft-json', '{"nftables":[{"table":{"family":"inet","name":"f"}},{"chain":{"family":"inet","table":"f","name":"input","policy":"drop"}}]}'],
    ['nft-no-expr', 'nft-json', '{"nftables":[{"table":{"family":"inet","name":"f"}},{"chain":{"family":"inet","table":"f","name":"input"}},{"rule":{"family":"inet","table":"f","chain":"input"}}]}'],
    ['nft-NUL', 'nft-json', "{\"nftables\":[]}\0"],
    ['iptables-unclosed', 'iptables-save', "*filter\n:INPUT DROP [0:0]\n"],
    ['iptables-commit-alone', 'iptables-save', "COMMIT\n"],
    ['iptables-orphan-rule', 'iptables-save', "*filter\n-A INPUT -j DROP\nCOMMIT\n"],
    ['iptables-duplicate-chain', 'iptables-save', "*filter\n:INPUT DROP [0:0]\n:INPUT DROP [0:0]\nCOMMIT\n"],
    ['iptables-duplicate-table', 'iptables-save', "*filter\n:INPUT DROP [0:0]\nCOMMIT\n*filter\nCOMMIT\n"],
    ['iptables-no-rule-body', 'iptables-save', "*filter\n:INPUT DROP [0:0]\n-A INPUT\nCOMMIT\n"],
    ['iptables-unexpected-command', 'iptables-save', "*filter\n:INPUT DROP [0:0]\n-F\nCOMMIT\n"],
    ['iptables-control', 'iptables-save', "*filter\n:INPUT DROP [0:0]\n-A INPUT -s SECRET_TOKEN\x01\nCOMMIT\n"],
    ['iptables-unterminated', 'iptables-save', "*filter\n:INPUT DROP [0:0]\nCOMMIT"],
    ['iptables-bad-name', 'iptables-save', "*filter\n:INPUT/SECRET DROP [0:0]\nCOMMIT\n"],
);
for my $bad (@bad) { negative(@$bad); }

# General CLI errors are distinct from an invalid firewall snapshot.
for my $args (
    [], ['--source','unknown'], ['--source','ufw-status','--format','yaml'],
    ['--source','ufw-status','--input',''],
    ['--source','ufw-config','extra'], ['--source','nft-json','--source','x'],
) {
    my ($rc, $out, $err) = run_cli(@$args);
    is($rc, 2, 'invalid option rejected with usage status');
    is($out, '', 'invalid option does not emit inventory');
}
my ($rc, $out, $err) = run_cli('--source','ufw-status','--input',"$temp/not-here-SECRET_TOKEN");
is($rc, 3, 'missing file rejected');
is($out, '', 'no inventory when file missing');
unlike($err, qr/SECRET_TOKEN/, 'input path never leaked');
my $target = snapshot("Status: active\n");
my $symlink = "$temp/link-SECRET_TOKEN";
symlink($target, $symlink) or die "symlink fixture failed: $!";
($rc, $out, $err) = run_cli('--source','ufw-status','--input',$symlink);
is($rc, 3, 'symlinked fixture rejected');
is($out, '', 'symlink refusal emits no report');
unlike($err, qr/SECRET_TOKEN/, 'symlink path not leaked');
($rc,$out,$err)=run_fixture('ufw-config', "ENABLED=yes\r\nLOGLEVEL=low\r\n");
is($rc,0,'ordinary CRLF UFW config accepted');
like($out, qr/\tENABLED\t/, 'CRLF UFW setting interpreted correctly');

# Verify that using a different parser is never an implicit fallback. This
# prevents accidental reinterpretation as a 'disabled' firewall status.
negative('source-confusion', 'nft-json', "Status: inactive\n");

# Byte limits apply in both the CLI and the pure parser. An oversized
# file must never leak its tail or produce a plausible partial inventory.
my $oversized = snapshot('ENABLED=yes' . ('#' x (8 * 1024 * 1024)) . "\n");
($rc, $out, $err) = run_cli('--source', 'ufw-config', '--input', $oversized);
is($rc, 3, '8 MiB input boundary enforced before parsing');
is($out, '', 'oversized file produces no partial inventory');
like($err, qr/exceeds byte limit/, 'oversized file rejected with safe message');

# A valid JSON payload must not have a second document appended to it.
negative('nft-trailing-document', 'nft-json', '{"nftables":[]}{"nftables":[]}');

done_testing();
